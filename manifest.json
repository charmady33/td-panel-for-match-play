{
  "manifest_version": 3,
  "name": "Matchplay TD Panel",
  "version": "0.11.2",
  "description": "Tournament director tools built into app.matchplay.events: finals check-in and eligibility, tiebreakers that matter, bank building and assignment, auto rounds, game timers and IFPA submission.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://app.matchplay.events/*",
    "https://api.matchplay.events/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.matchplay.events/*"
      ],
      "js": [
        "src/early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.matchplay.events/*"
      ],
      "js": [
        "src/util.js",
        "src/flag.js",
        "src/cats.js",
        "src/api.js",
        "src/logs.js",
        "src/timing.js",
        "src/banks.js",
        "src/mpui.js",
        "src/data.js",
        "src/finals.js",
        "src/bankplan.js",
        "src/worker.js",
        "src/sync.js",
        "src/jobs.js",
        "src/panel.js",
        "src/embed.js",
        "src/inpage.js",
        "src/ties.js",
        "src/bankbar.js",
        "src/arenatab.js",
        "src/ifpa.js",
        "src/busy.js",
        "src/deltest.js",
        "src/elig.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Matchplay TD Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "bg.js"
  }
}